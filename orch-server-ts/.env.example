# Orch server TypeScript runtime environment reference.
# All assignments intentionally have no value. Set deployment values in the
# process manager or an ignored local environment file; never commit secrets.

# Required. Use development, test, or production.
ENVIRONMENT=
# Required listener address and database connection. PORT defaults to 5200.
HOST=
PORT=
DATABASE_URL=

# Optional dashboard serving and per-user folder access JSON.
DASHBOARD_DIR=
DASHBOARD_USER_FOLDER_ACCESS=

# Optional R2 board asset storage.
R2_BOARD_ASSETS_ACCESS_KEY_ID=
R2_BOARD_ASSETS_SECRET_ACCESS_KEY=
R2_BOARD_ASSETS_BUCKET=
R2_BOARD_ASSETS_ENDPOINT=

# Optional Atom integration.
ATOM_ENABLED=
ATOM_SERVER_URL=
ATOM_API_KEY=
ATOM_ROOT_NODE_ID=

# Production requires both a bearer and at least one allowed CORS origin.
# Development may deliberately leave AUTH_BEARER_TOKEN empty.
AUTH_BEARER_TOKEN=
CORS_ALLOWED_ORIGINS=

# Optional Google dashboard authentication.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_IOS_CLIENT_ID=
ALLOWED_EMAIL=
JWT_SECRET=

# Required Claude OAuth client configuration.
CLAUDE_OAUTH_CLIENT_ID=
CLAUDE_OAUTH_CALLBACK_URL=

# Required for semantic search expansion. The preset must be explicit in the
# node's model catalog; the backend model ID is resolved from that file.
MODEL_CATALOG_PATH=
SEARCH_QUERY_EXPANSION_PRESET_ID=
SEARCH_QUERY_EXPANSION_EFFORT=

# Optional usage summaries and runner-process controls.
TURN_SUMMARY_OPENAI_KEY=
USAGE_SUMMARY_POLL_INTERVAL_SECONDS=
SOUL_RUNNER_PROCESS_ENABLED=
SOUL_RUNNER_LEASE_TIMEOUT_MS=

# Optional human-readable node label.
NODE_NAME=
