# Orch server TypeScript runtime environment reference.
# All assignments intentionally have no value. Set deployment values in the
# process manager or an ignored local environment file; never commit secrets.

# Required. Use development, test, or production.
ENVIRONMENT=
# Required listener address and database connection. PORT defaults to 5200.
HOST=
PORT=
DATABASE_URL=

# Optional dashboard serving.
DASHBOARD_DIR=

# Board and attachment R2 settings are managed in the central DB admin settings.

# Optional Atom integration.
ATOM_ENABLED=
ATOM_SERVER_URL=
ATOM_API_KEY=
ATOM_ROOT_NODE_ID=
SKILL_CATALOG_NODE_ID=

# Production requires both a bearer and at least one allowed CORS origin.
# Development may deliberately leave AUTH_BEARER_TOKEN empty.
AUTH_BEARER_TOKEN=
CORS_ALLOWED_ORIGINS=

# Optional Google dashboard authentication.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_IOS_CLIENT_ID=
ALLOWED_EMAIL=
JWT_SECRET=

# Required Claude OAuth client configuration.
CLAUDE_OAUTH_CLIENT_ID=
CLAUDE_OAUTH_CALLBACK_URL=

# Optional for expanded session search. Missing keys return partial RRF results.
TYPESAFE_API_KEY=

# Optional for other Codex ephemeral routes.
CODEX_CLI_PATH=
MODEL_CATALOG_PATH=

# Optional usage summaries and runner-process controls.
TURN_SUMMARY_OPENAI_KEY=
USAGE_SUMMARY_POLL_INTERVAL_SECONDS=
USAGE_SUMMARY_SHARED_ACCOUNTS=
SOUL_RUNNER_PROCESS_ENABLED=
SOUL_RUNNER_LEASE_TIMEOUT_MS=

# Optional human-readable node label.
NODE_NAME=

# Orchestrator-owned dot ingress, subscription state, and outbound delivery.
# NODE_NAME is required when ingress is enabled. Inventory: 63 audience=all tools.
# Dedicated ingress is disabled by default.
MCP_EXTERNAL_INGRESS_ENABLED=
MCP_EXTERNAL_INGRESS_PATH=
MCP_EXTERNAL_INGRESS_SOURCE=
MCP_EXTERNAL_INGRESS_DISPLAY_NAME=
MCP_EXTERNAL_INGRESS_BEARER_TOKEN=
MCP_EXTERNAL_EVENTS_STATE_FILE=
# Host allowlist for the dedicated connector.
MCP_ALLOWED_HOSTS=
