{
  "name": "@soulstream/orch-server-ts",
  "version": "0.0.1",
  "private": true,
  "description": "Production TypeScript orchestrator and API.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup && npm run verify:bundle",
    "start": "node dist/production_main.js",
    "plan:page-yjs-snapshot-repair": "tsx scripts/plan-page-yjs-snapshot-repair.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:bundle": "node --test ../scripts/verify-workspace-bundle.test.mjs && node ../scripts/verify-workspace-bundle.mjs dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/middie": "9.3.3",
    "@fastify/websocket": "11.2.0",
    "@hocuspocus/extension-database": "3.4.4",
    "@hocuspocus/server": "3.4.4",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@soulstream/agent-profile-contract": "workspace:*",
    "@soulstream/fractional-position": "workspace:*",
    "@soulstream/mcp-contract": "workspace:*",
    "@soulstream/model-catalog": "workspace:*",
    "@soulstream/page-model": "workspace:*",
    "@soulstream/search-contract": "workspace:*",
    "@soulstream/wire-schema": "workspace:*",
    "fastify": "^5.1.0",
    "google-auth-library": "10.9.0",
    "ipaddr.js": "2.5.0",
    "oidc-provider": "9.12.2",
    "openai": "6.37.0",
    "postgres": "3.4.9",
    "standardwebhooks": "1.1.1",
    "y-protocols": "1.0.6",
    "yaml": "^2.9.0",
    "yjs": "13.6.27",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@hocuspocus/provider": "3.4.4",
    "@modelcontextprotocol/client": "2.2.0",
    "@types/node": "^22.0.0",
    "@types/oidc-provider": "9.13.1",
    "@types/ws": "8.18.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "^8.18.0"
  }
}
