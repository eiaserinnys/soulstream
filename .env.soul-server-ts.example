# Soulstream TypeScript worker configuration

# Required
SOULSTREAM_NODE_ID=local-worker
SOULSTREAM_UPSTREAM_URL=ws://127.0.0.1:5200/ws/node
EVENT_OUTBOX_DIR=.local/event-outbox

# PostgreSQL persistence is hosted by the orchestrator. The worker runtime does
# not consume DATABASE_URL. Standalone release tooling may add it to the
# generated deployment environment for database initialization and migrations.

# Local HTTP server
HOST=127.0.0.1
PORT=4205
ENVIRONMENT=development
LOG_LEVEL=info

# Auth
# Required when ENVIRONMENT=production.
AUTH_BEARER_TOKEN=

# MCP post-start health contract
MCP_ENABLED=true
MCP_PATH=/mcp
MCP_INTERNAL_PORT=4206
MCP_STATELESS_TRANSPORT_ENABLED=false
MCP_REQUIRE_AUTH=false

# Agent registry
AGENTS_CONFIG_PATH=config/agents.yaml
AGENT_PROFILE_CACHE_PATH=.local/cache/agent-profiles.json
MODEL_CATALOG_PATH=config/model-catalog.yaml

# Runtime files
INCOMING_FILE_DIR=.local/incoming

# Claude persistent runtime v2 (default-on; false is the emergency kill switch)
CLAUDE_SESSION_RUNTIME_V2_ENABLED=true
CLAUDE_SESSION_RUNTIME_IDLE_TTL_MS=300000
CLAUDE_SESSION_RUNTIME_MAX_ENTRIES=16
CLAUDE_SESSION_RUNTIME_TURN_TIMEOUT_MS=1800000

# Optional user display metadata advertised to the orchestrator
DASH_USER_NAME=
DASH_USER_PORTRAIT=
