{
  "schema_version": 1,
  "upstream": "https://soulstream.eiaserinnys.me",
  "node_ws_url": "wss://soulstream.eiaserinnys.me/ws/node",
  "check_interval_secs": 60,
  "json_timeout_ms": 15000,
  "stream_timeout_ms": 3600000,
  "pairing_poll_interval_secs": 3,
  "restart_delay_ms": 3000,
  "ready_window_ms": 10000,
  "shutdown_grace_ms": 20000,
  "repositories": {
    "workspace": {
      "proxy_path": "/api/node/git/seosoyoung_workspace",
      "sparse_patterns": ["/*", "!/.local/artifacts/"]
    },
    "common": {
      "proxy_path": "/api/node/git/seosoyoung-common"
    }
  }
}
