{
  "name": "@soulstream/soul-server-ts",
  "version": "0.0.1",
  "private": true,
  "description": "Soulstream TypeScript execution worker for Claude, Codex, OpenAI Agents, MCP, and realtime services.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup --config tsup.config.ts --target node22 && tsup --config tsup.runner.config.ts --target node22 && node scripts/write_runner_release_package.mjs && npm run verify:bundle",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:contracts": "tsc --noEmit -p tsconfig.contracts.json",
    "verify:bundle": "node --test ../scripts/verify-workspace-bundle.test.mjs && node ../scripts/verify-workspace-bundle.mjs dist && node scripts/verify_runner_release_isolation.mjs",
    "contract:claude-sdk": "tsx scripts/claude_sdk_contract_harness.ts",
    "runner-outbox:inspect": "tsx scripts/inspect_runner_outbox.ts",
    "soak:runner": "tsx scripts/staging-soak/cli.ts",
    "agent-profiles:import": "tsx scripts/import-agent-profiles.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.218",
    "@anthropic-ai/sdk": "0.93.0",
    "@fastify/websocket": "11.2.0",
    "@hocuspocus/extension-database": "3.4.4",
    "@hocuspocus/server": "3.4.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/agents": "0.11.4",
    "@openai/codex-sdk": "^0.130.0",
    "@soulstream/fractional-position": "workspace:*",
    "@soulstream/page-model": "workspace:*",
    "@soulstream/search-contract": "workspace:*",
    "@soulstream/wire-schema": "workspace:*",
    "dotenv": "^16.4.7",
    "fastify": "^5.1.0",
    "pino": "^9.5.0",
    "ws": "^8.18.0",
    "y-protocols": "1.0.6",
    "yaml": "^2.9.0",
    "yjs": "13.6.27",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "postgres": "^3.4.9",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
