{
  "name": "@soulstream/soul-server-ts",
  "version": "0.0.1",
  "private": true,
  "description": "Soulstream TypeScript execution worker for Claude, Codex, Antigravity, OpenCode, MCP, and realtime services.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build_dist.mjs --target node22",
    "build:portable": "tsup --config tsup.portable.config.ts",
    "pack:portable": "tsx scripts/pack_portable_release.ts",
    "verify:portable": "node --test scripts/verify_portable_release.test.mjs",
    "release:portable": "npm run pack:portable",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "check:quick": "vitest run tests/runtime/composition_boundary.test.ts tests/mcp/tool_inventory_snapshot.test.ts --minWorkers=1 --maxWorkers=2",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "typecheck:contracts": "tsc --noEmit -p tsconfig.contracts.json",
    "verify:bundle": "node scripts/verify_bundle.mjs",
    "verify:startup": "node --test scripts/verify_main_bundle_runner_startup.test.mjs",
    "contract:claude-sdk": "tsx scripts/claude_sdk_contract_harness.ts",
    "runner-outbox:inspect": "tsx scripts/inspect_runner_outbox.ts",
    "notification-outbox:list-dlq": "tsx scripts/list_notification_dlq.ts",
    "notification-outbox:requeue": "tsx scripts/requeue_notification_dlq.ts",
    "soak:runner": "tsx scripts/staging-soak/cli.ts",
    "agent-profiles:import": "tsx scripts/import-agent-profiles.ts",
    "claude-accounts:adopt": "tsx scripts/adopt_claude_account.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.218",
    "@anthropic-ai/sdk": "0.93.0",
    "@fastify/websocket": "11.2.0",
    "@hocuspocus/extension-database": "3.4.4",
    "@hocuspocus/server": "3.4.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "^0.155.1",
    "@soulstream/agent-profile-contract": "workspace:*",
    "@soulstream/atomic-file-rename": "workspace:*",
    "@soulstream/executable-path": "workspace:*",
    "@soulstream/chat-ui": "workspace:*",
    "@soulstream/fractional-position": "workspace:*",
    "@soulstream/model-catalog": "workspace:*",
    "@soulstream/page-model": "workspace:*",
    "@soulstream/search-contract": "workspace:*",
    "@soulstream/wire-schema": "workspace:*",
    "dotenv": "^16.4.7",
    "fastify": "^5.1.0",
    "pino": "^9.5.0",
    "ws": "^8.18.0",
    "y-protocols": "1.0.6",
    "yaml": "^2.9.0",
    "yjs": "13.6.27",
    "zod": "^4.3.6",
    "@soulstream/mcp-contract": "workspace:*",
    "xstate": "5.33.4"
  },
  "devDependencies": {
    "@soulstream/statechart": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "postgres": "^3.4.9",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
