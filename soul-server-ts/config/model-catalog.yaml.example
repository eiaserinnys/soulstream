presets:
  - id: claude-sonnet
    label: Claude - Sonnet
    backend: claude
    model: sonnet
  - id: claude-opus
    label: Claude - Opus
    backend: claude
    model: opus
  - id: claude-fable
    label: Claude - Fable
    backend: claude
    model: "claude-fable-5[1m]"
    usage_model_id: fable
  - id: codex-5.6-sol
    label: Codex - 5.6 Sol
    backend: codex
    model: gpt-5.6-sol
  - id: codex-5.6-lunar
    label: Codex - 5.6 Lunar
    backend: codex
    model: gpt-5.6-lunar
  - id: codex-5.6-terra
    label: Codex - 5.6 Terra
    backend: codex
    model: gpt-5.6-terra
  - id: kimi-2
    label: Kimi - 2
    backend: claude
    model: kimi-for-coding
    env:
      ANTHROPIC_BASE_URL: https://api.kimi.com/coding/
      ANTHROPIC_API_KEY: "${KIMI_API_KEY}"
      CLAUDE_CODE_AUTO_COMPACT_WINDOW: "262144"
  - id: kimi-3
    label: Kimi - 3
    backend: claude
    model: kimi-3-for-coding
    env:
      ANTHROPIC_BASE_URL: https://api.kimi.com/coding/
      ANTHROPIC_API_KEY: "${KIMI_API_KEY}"
      CLAUDE_CODE_AUTO_COMPACT_WINDOW: "262144"
