# 노드 로컬 모델 카탈로그 예시.
#
# 설치
#   이 파일을 노드의 서비스 shared 디렉토리에 `model-catalog.yaml`로 복사하고,
#   env에 절대경로를 등록한다.
#
#     MODEL_CATALOG_PATH=<shared>/model-catalog.yaml
#
#   `agents.yaml`·`mcp-profiles.yaml`과 같은 자리에 둔다. 릴리스 디렉토리가 아니라
#   shared에 두어야 배포마다 덮어써지지 않는다.
#
# 반영 시점
#   파일 내용은 매 조회마다 다시 읽지만, 오케스트레이터에 광고하는 시점은
#   노드가 WS에 연결할 때 한 번뿐이다. 따라서 파일을 새로 깔거나 고쳤다면
#   soul-server-ts를 재시작해야 목록에 반영된다.
#
# 없을 때
#   파일이 없으면 빈 카탈로그로 degrade하고 경고 로그를 남긴다. 서버는 정상
#   기동하지만 그 노드에서는 모델 선택지가 하나도 보이지 않는다.
#   파일이 있는데 YAML이 깨져 있으면 기동 시점에 명시적으로 실패한다.
#
# preset id는 전 노드 공통 어휘다. 같은 id가 노드마다 다른 model 문자열을
# 가리켜도 되지만(예: fable 계열의 실제 표기), id 자체는 통일한다.
# 노드에 인증이 없는 preset은 지우지 말고 그대로 둔다 — 런타임에 사유와 함께
# 비활성으로 표시되는 편이 목록에서 사라지는 것보다 낫다.

# effort (선택)
#   `supported_efforts`는 그 모델이 *실제로 광고하는* effort 목록이다. 추측해서
#   적지 말고 노드에서 직접 조회한 값을 쓴다.
#     Claude : SDK `query.supportedModels()` -> supportedEffortLevels
#     Codex  : `codex app-server` JSON-RPC `model/list` -> supportedReasoningEfforts
#   `default_effort`는 생성 요청이 effort를 생략했을 때 적용되며 반드시
#   `supported_efforts` 안에 있어야 한다(아니면 기동 시 검증 실패).
#   두 필드를 모두 생략하면 그 preset은 effort 선택 UI 없이 "자동(백엔드 기본값)"으로
#   표시된다. 벤더가 effort를 지원하지 않는 preset은 반드시 이 상태로 둔다 —
#   지원하지도 않는 값을 화면에만 띄우지 않기 위해서다.
#   아래 값은 260906 eiaserinnys 실측 기준이다. 노드마다 CLI/SDK 버전이 다르면
#   광고 목록도 다를 수 있으므로 노드별로 재조회한다.

presets:
  - id: claude-sonnet
    label: Claude - Sonnet
    backend: claude
    model: sonnet
    supported_efforts: [low, medium, high, xhigh, max]
    default_effort: xhigh
  - id: claude-opus
    label: Claude - Opus
    backend: claude
    model: opus
    supported_efforts: [low, medium, high, xhigh, max]
    default_effort: xhigh
  - id: claude-fable
    label: Claude - Fable
    backend: claude
    model: "claude-fable-5-1[1m]"
    usage_model_id: fable
    supported_efforts: [low, medium, high, xhigh, max]
    default_effort: high
  - id: codex-6-astra
    label: Codex - 6 Astra
    backend: codex
    model: gpt-6-astra
    supported_efforts: [low, medium, high, xhigh, max, ultra]
    default_effort: medium
  - id: codex-5.6-sol
    label: Codex - 5.6 Sol
    backend: codex
    model: gpt-5.6-sol
    supported_efforts: [low, medium, high, xhigh, max, ultra]
    default_effort: xhigh
  # 260906: 실제 노드 카탈로그의 id/model은 luna다. 예시가 lunar로 어긋나 있어
  # 실측 대상과 맞췄다.
  - id: codex-5.6-luna
    label: Codex - 5.6 Luna
    backend: codex
    model: gpt-5.6-luna
    supported_efforts: [low, medium, high, xhigh, max]
    default_effort: xhigh
  - id: codex-5.6-terra
    label: Codex - 5.6 Terra
    backend: codex
    model: gpt-5.6-terra
    supported_efforts: [low, medium, high, xhigh, max, ultra]
    default_effort: xhigh
  - id: codex-5.3-spark
    label: Codex - 5.3 Spark
    backend: codex
    model: gpt-5.3-codex-spark
    supported_efforts: [low, medium, high, xhigh]
    default_effort: xhigh
  # Kimi 두 preset은 effort를 선언하지 않는다. 벤더의 Anthropic 호환 엔드포인트가
  # 공식 필드 `output_config.effort`를 검증하지 않고 무시한다(260906 실측: 잘못된
  # 값에도 200 응답). 지원 근거가 생기면 그때 두 필드를 추가한다.
  - id: kimi-2
    label: Kimi - 2
    backend: claude
    # 실측(260728): "kimi-for-coding"의 display_name은 "K2.7 Coding".
    # 같은 계열의 "kimi-for-coding-highspeed"는 목록에 노출하지 않는다.
    model: kimi-for-coding
    env:
      ANTHROPIC_BASE_URL: https://api.kimi.com/coding/
      ANTHROPIC_API_KEY: "${KIMI_API_KEY}"
      CLAUDE_CODE_AUTO_COMPACT_WINDOW: "262144"
  - id: kimi-3
    label: Kimi - 3
    backend: claude
    # 실측(260728, GET https://api.kimi.com/coding/v1/models): K3 = "k3".
    # 같은 엔드포인트의 "k3-256k"는 context_length가 262144로 동일하고
    # 비디오 입력만 빠진 부분집합이라 "k3"를 정본으로 둔다.
    model: k3
    env:
      ANTHROPIC_BASE_URL: https://api.kimi.com/coding/
      ANTHROPIC_API_KEY: "${KIMI_API_KEY}"
      CLAUDE_CODE_AUTO_COMPACT_WINDOW: "262144"
