{
  "schema_version": "haniel.release.v1",
  "release_id": "soulstream-worker-env-bound-v2",
  "environment_service": "soulstream-server",
  "requires_service_env_file": true,
  "change_ignore_paths": [
    "soul-app/src/*",
    "soul-app/assets/*",
    "soul-app/docs/*",
    "soul-app/patches/*",
    "soul-app/plugins/*",
    "soul-app/scripts/*",
    "soul-app/targets/*",
    "soul-app/modules/*/src/*",
    "soul-app/modules/*/ios/*",
    "soul-app/modules/*/expo-module.config.json",
    "soul-app/card-image-review/[!p]*",
    "soul-app/component-review/[!p]*",
    "soul-app/mockup/[!p]*",
    "soul-app/*.ts",
    "soul-app/*.tsx",
    "soul-app/*.js",
    "soul-app/*.md",
    "soul-app/*.yaml",
    "soul-app/app.json",
    "soul-app/eas.json",
    "soul-app/tsconfig.json",
    "soul-app/package-lock.json",
    "soul-app/.gitignore",
    "docs/*",
    ".github/*",
    "install/*",
    "portable-node/*",
    "assets/*",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "LICENSE",
    ".gitignore",
    ".gitattributes",
    ".easignore",
    ".env.soul-server-ts.example",
    "unified-dashboard/[!p]*",
    "orch-server-ts/[!p]*",
    "soul-desktop/[!p]*",
    "chrome-extension/[!p]*",
    "packages/soul-ui/[!p]*"
  ],
  "post_start_verify": [
    {
      "name": "verify-release-health",
      "command": "node soul-server-ts/scripts/verify-release-health.mjs --scope cluster",
      "timeout_seconds": 300
    }
  ],
  "recovery": {
    "strategy": "rollback",
    "command": {
      "name": "verify-release-health",
      "command": "node soul-server-ts/scripts/verify-release-health.mjs --scope cluster",
      "timeout_seconds": 300
    }
  }
}
