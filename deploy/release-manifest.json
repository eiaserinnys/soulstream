{
  "schema_version": "haniel.release.v1",
  "release_id": "soulstream-claude-runtime-v2",
  "environment_service": "soulstream-orch-server",
  "service_restart_strategies": {
    "soulstream-orch-server": { "mode": "overlap", "exit_timeout_sec": 60 },
    "soulstream-soul-server-ts": { "mode": "adopt" }
  },
  "migration": {
    "operation": "discover",
    "result_contract": "soulstream.database-release.v1",
    "provenance_probe": {
      "prepare": {
        "name": "prepare-database-release-probe",
        "command": "corepack pnpm install --frozen-lockfile --ignore-scripts",
        "timeout_seconds": 300
      },
      "probe": {
        "name": "probe-database-release",
        "command": "node packages/db-schema/scripts/release-executor.mjs probe --manifest deploy/release-manifest.json --database-contract deploy/database-release-central.json",
        "timeout_seconds": 300
      }
    },
    "preflight": {
      "name": "migration-preflight",
      "command": "node packages/db-schema/scripts/release-executor.mjs preflight --manifest deploy/release-manifest.json --database-contract deploy/database-release-central.json",
      "timeout_seconds": 300
    },
    "apply": {
      "name": "apply-central-database-release",
      "command": "node packages/db-schema/scripts/release-executor.mjs apply --manifest deploy/release-manifest.json --database-contract deploy/database-release-central.json",
      "timeout_seconds": 300
    }
  },
  "post_start_verify": [
    {
      "name": "verify-migration-ledger",
      "command": "node packages/db-schema/scripts/release-executor.mjs verify --manifest deploy/release-manifest.json --database-contract deploy/database-release-central.json",
      "timeout_seconds": 300
    },
    {
      "name": "verify-release-health",
      "command": "node soul-server-ts/scripts/verify-release-health.mjs --scope cluster",
      "timeout_seconds": 300
    }
  ],
  "recovery": {
    "strategy": "rollback",
    "command": {
      "name": "recover-database-release",
      "command": "node packages/db-schema/scripts/release-executor.mjs recover --manifest deploy/release-manifest.json --database-contract deploy/database-release-central.json",
      "timeout_seconds": 300
    }
  },
  "service_restart_filters": {
    "soulstream-orch-server": {
      "ignore_paths": [
        "soul-app/src/*",
        "soul-app/assets/*",
        "soul-app/docs/*",
        "soul-app/patches/*",
        "soul-app/plugins/*",
        "soul-app/scripts/*.cjs",
        "soul-app/scripts/*.js",
        "soul-app/scripts/*.mjs",
        "soul-app/scripts/*.py",
        "soul-app/scripts/*.ts",
        "soul-app/scripts/*.tsx",
        "soul-app/scripts/visual-check/attachment_preview/app.json",
        "soul-app/scripts/visual-check/attachment_preview/fixtures/*",
        "soul-app/targets/*",
        "soul-app/modules/*/src/*",
        "soul-app/modules/*/ios/*",
        "soul-app/modules/*/expo-module.config.json",
        "soul-app/*.ts",
        "soul-app/*.tsx",
        "soul-app/*.js",
        "soul-app/*.md",
        "soul-app/*.yaml",
        "soul-app/app.json",
        "soul-app/eas.json",
        "soul-app/tsconfig.json",
        "soul-app/package-lock.json",
        "soul-app/.gitignore",
        "soul-app/card-image-review/app.json",
        "soul-app/component-review/app.json",
        "soul-app/component-review/review.css",
        "soul-desktop/[!p]*",
        "chrome-extension/[!p]*",
        "chrome-extension/public/*",
        "portable-node/*",
        "install/*",
        "docs/*",
        "assets/*",
        ".github/*",
        "packages/soul-ui/[!p]*",
        "packages/db-schema/[!p]*",
        "packages/db-schema/pyproject.toml",
        ".easignore",
        ".gitattributes",
        ".gitignore",
        ".env.soul-server-ts.example",
        "AGENTS.md",
        "CLAUDE.md",
        "README.md",
        "LICENSE",
        "packages/mcp-contract/tests/*",
        "packages/page-model/tests/*",
        "packages/wire-schema/tests/*",
        "packages/page-model/src/session_binding_warnings.test.ts",
        "packages/search-contract/src/session-intent.test.ts",
        "unified-dashboard/[!p]*",
        "unified-dashboard/p[!a]*",
        "soul-server-ts/[!p]*",
        "packages/chat-ui/[!p]*",
        "orch-server-ts/tests/*"
      ]
    },
    "soulstream-soul-server-ts": {
      "ignore_paths": [
        "soul-app/src/*",
        "soul-app/assets/*",
        "soul-app/docs/*",
        "soul-app/patches/*",
        "soul-app/plugins/*",
        "soul-app/scripts/*.cjs",
        "soul-app/scripts/*.js",
        "soul-app/scripts/*.mjs",
        "soul-app/scripts/*.py",
        "soul-app/scripts/*.ts",
        "soul-app/scripts/*.tsx",
        "soul-app/scripts/visual-check/attachment_preview/app.json",
        "soul-app/scripts/visual-check/attachment_preview/fixtures/*",
        "soul-app/targets/*",
        "soul-app/modules/*/src/*",
        "soul-app/modules/*/ios/*",
        "soul-app/modules/*/expo-module.config.json",
        "soul-app/*.ts",
        "soul-app/*.tsx",
        "soul-app/*.js",
        "soul-app/*.md",
        "soul-app/*.yaml",
        "soul-app/app.json",
        "soul-app/eas.json",
        "soul-app/tsconfig.json",
        "soul-app/package-lock.json",
        "soul-app/.gitignore",
        "soul-app/card-image-review/app.json",
        "soul-app/component-review/app.json",
        "soul-app/component-review/review.css",
        "soul-desktop/[!p]*",
        "chrome-extension/[!p]*",
        "chrome-extension/public/*",
        "portable-node/*",
        "install/*",
        "docs/*",
        "assets/*",
        ".github/*",
        "packages/soul-ui/[!p]*",
        "packages/db-schema/[!p]*",
        "packages/db-schema/pyproject.toml",
        ".easignore",
        ".gitattributes",
        ".gitignore",
        ".env.soul-server-ts.example",
        "AGENTS.md",
        "CLAUDE.md",
        "README.md",
        "LICENSE",
        "packages/mcp-contract/tests/*",
        "packages/page-model/tests/*",
        "packages/wire-schema/tests/*",
        "packages/page-model/src/session_binding_warnings.test.ts",
        "packages/search-contract/src/session-intent.test.ts",
        "unified-dashboard/[!p]*",
        "unified-dashboard/p[!a]*",
        "orch-server-ts/[!p]*",
        "soul-server-ts/tests/*",
        "packages/chat-ui/tests/*"
      ]
    }
  }
}
