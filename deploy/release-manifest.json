{
  "schema_version": "haniel.release.v1",
  "release_id": "soulstream-claude-runtime-v2",
  "environment_service": "soulstream-orch-server",
  "migration": {
    "destructive": true,
    "operation": "discover",
    "result_contract": "soulstream.database-release.v1",
    "provenance_probe": {
      "prepare": {
        "name": "prepare-database-release-probe",
        "command": "corepack pnpm install --frozen-lockfile --ignore-scripts --config.strict-dep-builds=false",
        "timeout_seconds": 300
      },
      "probe": {
        "name": "probe-database-release",
        "command": "node packages/db-schema/scripts/release-executor.mjs probe --manifest deploy/release-manifest.json --database-contract deploy/database-release-central.json",
        "timeout_seconds": 300
      }
    },
    "preflight": {
      "name": "migration-preflight",
      "command": "node packages/db-schema/scripts/release-executor.mjs preflight --manifest deploy/release-manifest.json --database-contract deploy/database-release-central.json",
      "timeout_seconds": 300
    },
    "backup": {
      "name": "database-backup",
      "command": "node packages/db-schema/scripts/release-executor.mjs backup --manifest deploy/release-manifest.json --database-contract deploy/database-release-central.json",
      "timeout_seconds": 300
    },
    "verify_backup": {
      "name": "verify-database-backup",
      "command": "node packages/db-schema/scripts/release-executor.mjs verify-backup --manifest deploy/release-manifest.json --database-contract deploy/database-release-central.json",
      "timeout_seconds": 300
    },
    "apply": {
      "name": "apply-migrations-and-board-yjs-residue",
      "command": "node orch-server-ts/node_modules/tsx/dist/cli.mjs orch-server-ts/scripts/deploy-board-yjs-runbook-residue.ts --migrate",
      "timeout_seconds": 300
    }
  },
  "post_start_verify": [
    {
      "name": "verify-migration-ledger",
      "command": "node packages/db-schema/scripts/release-executor.mjs verify --manifest deploy/release-manifest.json --database-contract deploy/database-release-central.json",
      "timeout_seconds": 300
    },
    {
      "name": "verify-release-health",
      "command": "node soul-server-ts/scripts/verify-release-health.mjs --scope cluster",
      "timeout_seconds": 300
    },
    {
      "name": "verify-board-yjs-runbook-residue",
      "command": "node orch-server-ts/node_modules/tsx/dist/cli.mjs orch-server-ts/scripts/deploy-board-yjs-runbook-residue.ts --verify",
      "timeout_seconds": 300
    }
  ],
  "recovery": {
    "strategy": "rollback",
    "command": {
      "name": "recover-database-release",
      "command": "node packages/db-schema/scripts/release-executor.mjs recover --manifest deploy/release-manifest.json --database-contract deploy/database-release-central.json",
      "timeout_seconds": 300
    }
  }
}
