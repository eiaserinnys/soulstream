# EAS uploads the Git root; include the independent npm app and its shared TS imports.
/*
!/soul-app
# EAS copy filtering checks parent directory paths without trailing slashes.
!/packages
/packages/*
!/packages/soul-ui
/packages/soul-ui/*
!/packages/soul-ui/src
/packages/soul-ui/src/*
!/packages/soul-ui/src/cards
/packages/soul-ui/src/cards/*
!/packages/soul-ui/src/cards/completed-cards.ts
!/packages/soul-ui/src/lib
/packages/soul-ui/src/lib/*
!/packages/soul-ui/src/lib/safe-error-detail.ts
!/packages/soul-ui/src/lib/turn-usage-format.ts
!/packages/wire-schema
/packages/wire-schema/*
!/packages/wire-schema/src
/packages/wire-schema/src/*
!/packages/wire-schema/src/card_colors.ts
!/packages/wire-schema/src/persistent_jev_candidates.ts

# .easignore replaces all .gitignore files, including soul-app/.gitignore.
node_modules/
.expo/
dist/
build/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
.env*
credentials.json
*.tsbuildinfo
coverage/
.local/
/soul-app/ios/
/soul-app/android/
