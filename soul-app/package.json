{
  "name": "soul-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "diagnostics:ios-errors": "npm exec --yes --package eas-cli@24.7.0 eas -- observe:errors --platform apple --days 14 --environment production --json",
    "diagnostics:ios-error-fingerprint": "npm exec --yes --package eas-cli@24.7.0 eas -- observe:errors --platform apple --days 90 --environment production --json",
    "diagnostics:ios-observe-versions": "npm exec --yes --package eas-cli@24.7.0 eas -- observe:versions --platform apple --days 90 --environment production --json",
    "diagnostics:ios-builds": "npm exec --yes --package eas-cli@24.7.0 eas -- build:list --platform ios --status finished --json",
    "diagnostics:ios-session-reports": "npm exec --yes --package eas-cli@24.7.0 eas -- observe:events soul-app.diagnostics.chunk --platform apple --days 14 --environment production --limit 100 --json"
  },
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "expo": "57.0.24",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-auth-session": "~57.0.12",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.21",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-observe": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "jwt-decode": "^4.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-enriched-markdown": "^0.5.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sse": "^1.2.1",
    "react-native-webrtc": "^124.0.7",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
