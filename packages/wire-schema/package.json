{
  "name": "@soulstream/wire-schema",
  "version": "0.0.1",
  "private": true,
  "description": "Soulstream upstream WS protocol — JSON Schema definitive + generated TypeScript client. See src/README.md.",
  "type": "module",
  "main": "generated/typescript/index.ts",
  "types": "generated/typescript/index.ts",
  "exports": {
    ".": "./generated/typescript/index.ts",
    "./delivery": "./src/delivery.ts",
    "./assigned-card-context-snapshot": "./src/assigned_card_context_snapshot.ts",
    "./schema": "./src/upstream.schema.json",
    "./persistent-jev-candidates": "./src/persistent_jev_candidates.ts",
    "./card-orchestration": "./src/card_orchestration.ts",
    "./card-attachments": "./src/card_attachments.ts",
    "./card-colors": "./src/card_colors.ts",
    "./persistent-session-settings": "./src/persistent_session_settings.ts",
    "./persistent-session-instructions": "./src/persistent_session_instructions.ts",
    "./resume-after-limit": "./src/resume_after_limit.ts"
  },
  "scripts": {
    "generate": "bash scripts/generate.sh",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4"
  }
}
