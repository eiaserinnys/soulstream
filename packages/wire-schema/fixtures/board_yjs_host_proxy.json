{
  "version": 1,
  "hostCapability": "board_yjs_host",
  "cardinality": {
    "zeroHostsStatus": 503,
    "twoHostsStatus": 503,
    "oneHostStatus": 200
  },
  "proxy": {
    "method": "POST",
    "route": "/api/markdown-documents",
    "upstreamPath": "/api/markdown-documents",
    "forwardedHeaders": [
      "authorization"
    ]
  },
  "directOperations": [
    {
      "operation": "create-markdown-document",
      "body": {
        "folderId": "folder-1",
        "title": "Note",
        "body": "Body",
        "x": 10,
        "y": 20,
        "documentId": "doc-1"
      }
    },
    {
      "operation": "upsert-session-board-item",
      "body": {
        "folderId": "task-1",
        "sessionId": "session-1",
        "x": 30,
        "y": 40,
        "sourceChecklistItemId": "item-1"
      }
    },
    {
      "operation": "move-session-to-folder",
      "body": {
        "sessionId": "session-1",
        "folderId": "folder-2"
      }
    },
    {
      "operation": "upsert-custom-view-board-item",
      "body": {
        "folderId": "folder-1",
        "boardItemId": "custom-view:view-1",
        "customViewId": "view-1",
        "title": "View",
        "html": "<p>View</p>",
        "revision": 2,
        "x": 70,
        "y": 80,
        "metadata": {
          "theme": "dark"
        }
      }
    },
    {
      "operation": "remove-board-item",
      "body": {
        "boardItemId": "session:session-1",
        "folderId": "task-1"
      }
    },
    {
      "operation": "update-board-item-position",
      "body": {
        "boardItemId": "session:session-1",
        "x": 90,
        "y": 100,
        "folderId": "task-1"
      }
    },
    {
      "operation": "move-board-item-to-folder",
      "body": {
        "boardItem": {
          "id": "session:session-1",
          "folderId": "folder-1",
          "membershipKind": "primary",
          "itemType": "session",
          "itemId": "session-1",
          "x": 30,
          "y": 40,
          "metadata": {},
          "sourceChecklistItemId": null
        },
        "position": {
          "x": 110,
          "y": 120
        },
        "folderId": "task-1"
      }
    },
    {
      "operation": "update-markdown-document",
      "body": {
        "documentId": "doc-1",
        "fields": {
          "title": "Updated",
          "body": "Updated body",
          "expectedVersion": 1
        },
        "folderId": "folder-1"
      }
    },
    {
      "operation": "delete-markdown-document",
      "body": {
        "documentId": "doc-1",
        "folderId": "folder-1"
      }
    }
  ],
  "negativeAssertions": [
    "catalog_service.create_markdown_document is not called for markdown write routes"
  ]
}
