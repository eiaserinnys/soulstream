{
  "name": "@seosoyoung/unified-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e:smoke": "pnpm build && playwright test --config playwright.smoke.config.ts",
    "test:e2e:chat-ui": "COMPONENTS_REVIEW_PHASE=chat-ui playwright test --config playwright.chat-ui.config.ts",
    "test:e2e:pas-report": "playwright test --config playwright.pas-report.config.ts",
    "test:e2e:quota-pace": "playwright test --config playwright.quota-pace.config.ts",
    "capture:readme": "playwright test --config playwright.readme-demo.config.ts",
    "qa:v3": "node e2e/run-v3-qa.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@pierre/words": "0.3.0",
    "@seosoyoung/soul-ui": "workspace:*",
    "@soulstream/chat-ui": "workspace:*",
    "@soulstream/i18n": "workspace:*",
    "@soulstream/search-contract": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "17.1.13",
    "simple-icons": "16.38.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^2.1.9"
  }
}
