# Runtime clone and fixed lab ports
LAB_REPO=/home/eias/services/soulstream-lab/repo
LAB_ORCH_PORT=5300
LAB_NODE_PORT=3116
LAB_POSTGRES_PORT=5437

# Dedicated Docker identity
LAB_POSTGRES_CONTAINER=soulstream-lab-postgres
LAB_POSTGRES_VOLUME=soulstream-lab-postgres-data
LAB_POSTGRES_DB=soulstream_lab
LAB_POSTGRES_USER=soulstream_lab

# Generated by bootstrap.sh. Never copy production values into these fields.
LAB_POSTGRES_PASSWORD=
LAB_AUTH_BEARER_TOKEN=
LAB_JWT_SECRET=

# bootstrap.sh copies an existing OAuth token file into the isolated lab state.
# The worker only receives the isolated destination path.
LAB_CLAUDE_AUTH_FILE=/home/eias/services/soulstream-lab/state/claude-auth.json
