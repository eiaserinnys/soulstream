      "packages/wire-schema/package.json",
      "deploy"
    ],
    "extensions": [".ts", ".tsx", ".mjs", ".cjs", ".js", ".json", ".html", ".sh", ".py", ".easignore"],
    "testDirectories": ["orch-server-ts/tests", "soul-server-ts/tests", "unified-dashboard/e2e"],
    "testExtensions": [".ts", ".tsx", ".mjs", ".cjs", ".js"],
    "allow": "\\.(type-test|type-contract|test-fixture|fixture|native|web|ios|android)\\.|(^|/)(index|main|production_main|App)\\.tsx?$|^soul-app/src/(test-support|test-utils)/",
