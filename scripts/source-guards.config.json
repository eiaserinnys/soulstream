  "recordCanonical": "packages/wire-schema/src/json_record.ts",
  "fingerprints": [
    {
      "label": "카드 상태 라벨 맵",
      "pattern": "(?<![\\w\"'])awaiting_verification[\"']?\\s*:\\s*[\"'][^\"']+[\"']",
      "canonical": ["packages/wire-schema/src/card_status_labels.ts"],
      "hint": "@soulstream/wire-schema/card-status-labels의 CARD_STATUS_LABELS를 쓴다"
    },
    {
      "label": "미리보기 MIME 목록",
      "pattern": "text/x-script\\.python",
      "canonical": ["packages/wire-schema/src/attachments.ts"],
      "hint": "SAFE_TEXT_PREVIEW_MIME_TYPES를 import한다"
    },
    {
      "label": "보고 링크 문법",
      "pattern": "\\(https:\\\\/\\\\/\\[\\^\\\\s\\)\\]\\+\\)",
      "canonical": ["packages/wire-schema/src/persistent_report.ts"],
      "hint": "reportActionParts를 쓴다"
    }
  ],
  "cyclePackages": ["orch", "worker", "soul-ui", "web", "app", "wire", "mcpc"],
  "packageScopes": ["@soulstream/", "@seosoyoung/"],
  "packageAliases": { "@shared/": "soul-ui" },
  "reexportPackages": ["orch", "worker", "soul-ui", "web", "app"],
  "crossPackages": ["orch", "worker", "soul-ui", "web", "app"],
  "packagePairs": [
    ["orch", "worker"],
    ["soul-ui", "app"],
    ["web", "app"],
    ["soul-ui", "web"]
  ],
  "intraPackages": ["orch", "worker", "soul-ui", "web", "app"],
  "deadModule": {
    "packages": ["orch", "worker", "soul-ui", "web", "app", "wire", "mcpc"],
    "extra": [
      "soul-app/scripts/review-metro-config.cjs",
      "orch-server-ts/scripts",
      "soul-server-ts/scripts",
      "soul-server-ts/tsup.portable.config.ts",
