diff --git a/cf/src/connection.js b/cf/src/connection.js
index 8e79170aeb13efe8c3c77ccede0cd3a115b5e1b5..7393c15ad2c4135326f9f18c8314f6be465c38b5 100644
--- a/cf/src/connection.js
+++ b/cf/src/connection.js
@@ -172,11 +172,18 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
         : (query = q, query.active = true)
 
       build(q)
-      return write(toBuffer(q))
+      const flushed = write(toBuffer(q))
+      // The query is already on the wire, so onexecute (sql.begin's reserved
+      // marker) must run whatever the pipeline state. It still reports "full" so
+      // no further query is loaded onto this connection.
+      if (q.options.onexecute) {
+        q.options.onexecute(connection)
+        return false
+      }
+      return flushed
         && !q.describeFirst
         && !q.cursorFn
         && sent.length < max_pipeline
-        && (!q.options.onexecute || q.options.onexecute(connection))
     } catch (error) {
       sent.length === 0 && write(Sync)
       errored(error)
